#!/bin/sh

OUT="/www/luci-static/proton2025/temperature.json"
TMP="/tmp/proton2025-temperature.json.$$"

mkdir -p /www/luci-static/proton2025
first=1

esc() {
  printf "%s" "$1" | sed "s/\\\\/\\\\\\\\/g; s/\"/'/g"
}

add_sensor() {
  name="$1"
  raw="$2"

  raw="$(printf "%s" "$raw" | tr -dc '0-9')"
  [ -n "$raw" ] || return

  if [ "$raw" -gt 1000 ] 2>/dev/null; then
    v10=$((raw / 100))
  else
    v10=$((raw * 10))
  fi

  int=$((v10 / 10))
  dec=$((v10 % 10))

  level="normal"
  [ "$int" -ge 50 ] && level="warm"
  [ "$int" -ge 70 ] && level="hot"
  [ "$int" -ge 85 ] && level="critical"

  [ "$first" -eq 0 ] && printf "," >> "$TMP"
  first=0

  printf '{"name":"%s","temp":"%s.%s","level":"%s"}' \
    "$(esc "$name")" "$int" "$dec" "$level" >> "$TMP"
}

printf '{"updated":%s,"sensors":[' "$(date +%s)" > "$TMP"

for z in /sys/class/thermal/thermal_zone*; do
  [ -f "$z/temp" ] || continue
  name="$(cat "$z/type" 2>/dev/null)"
  [ -n "$name" ] || name="$(basename "$z")"
  add_sensor "$name" "$(cat "$z/temp" 2>/dev/null)"
done

for h in /sys/class/hwmon/hwmon*; do
  [ -d "$h" ] || continue
  chip="$(cat "$h/name" 2>/dev/null)"
  [ -n "$chip" ] || chip="$(basename "$h")"

  for input in "$h"/temp*_input; do
    [ -f "$input" ] || continue
    base="$(basename "$input" _input)"
    label="$(cat "$h/${base}_label" 2>/dev/null)"
    [ -n "$label" ] || label="$chip $base"
    add_sensor "$label" "$(cat "$input" 2>/dev/null)"
  done
done

printf ']}\n' >> "$TMP"
mv "$TMP" "$OUT"
chmod 644 "$OUT"
