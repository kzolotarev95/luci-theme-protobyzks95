#!/bin/sh

STAMP="$(date +%s)"

echo "[proton2025] cache bust stamp: $STAMP"

uci -q get luci.themes >/dev/null 2>&1 || uci set luci.themes='internal'
uci set luci.themes.ProtoByZKS95='/luci-static/proton2025'
uci set luci.main.mediaurlbase='/luci-static/proton2025'
uci commit luci 2>/dev/null || true

find /www/luci-static -maxdepth 1 -type l -name 'proton2025-*' -exec rm -f {} \; 2>/dev/null || true

for f in \
  /usr/share/ucode/luci/template/themes/proton2025/header.ut \
  /usr/share/ucode/luci/template/themes/proton2025/footer.ut \
  /usr/share/ucode/luci/template/themes/proton2025/sysauth.ut \
  /usr/lib/lua/luci/view/themes/proton2025/header.htm \
  /usr/lib/lua/luci/view/themes/proton2025/footer.htm
do
  [ -f "$f" ] || continue

  sed -i -E "s#/luci-static/proton2025-[0-9]+/#/luci-static/proton2025/#g" "$f"
  sed -i -E "s#(/luci-static/proton2025/[^\"'<> ]+\.(js|css|svg|png|jpg|jpeg|webp|woff2))(\?v=[0-9]+)?#\1?v=$STAMP#g" "$f"
  sed -i -E "s#(cascade\.css)(\?v=[0-9]+)?#\1?v=$STAMP#g" "$f"
done

rm -rf /tmp/luci-* /tmp/luci-indexcache*

/etc/init.d/rpcd restart 2>/dev/null || true
/etc/init.d/uhttpd restart 2>/dev/null || true

echo "[proton2025] cache reset OK"
echo "[proton2025] active mediaurlbase:"
uci get luci.main.mediaurlbase 2>/dev/null || true

echo "[proton2025] registered themes:"
uci show luci.themes 2>/dev/null || true
